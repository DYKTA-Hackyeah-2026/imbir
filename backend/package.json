{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + TypeScript backend",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:assistant": "tsx scripts/dev-assistant-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "types:generate": "npm run openapi:emit && openapi-typescript openapi.json -o web/api-types.ts",
    "types:check": "tsc -p web/tsconfig.json",
    "verify": "npm run typecheck && npm run test && npm run build && npm run types:generate && npm run types:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:innovations": "tsx src/db/seed-innovations.ts",
    "db:seed:assistant": "tsx src/assistant/program.seed.ts",
    "db:seed:assistant-innovations": "tsx src/assistant/seed.assistant-innovations.ts",
    "db:seed:innovations": "tsx src/db/seed.innovations.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:e2e": "node scripts/e2e.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
