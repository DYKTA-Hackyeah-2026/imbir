# Production / staging environment for Dokploy.
#
# In Dokploy you do NOT commit a .env file. Instead, paste these keys into
# your application's "Environment" tab (Settings → Environment). Dokploy injects
# them into the container at runtime.
#
# Required values are marked with (required). Everything else has a sensible default.

# --- Runtime ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# --- Database (required) ---
# Paste the Internal Connection URL from your Dokploy PostgreSQL service.
# Dokploy exposes an internal host like "backend-db-xxxx:5432" reachable inside the
# Docker network. Use the internal URL, NOT the public one, for the API container.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DB_SSL=false
DB_POOL_MAX=10

# --- Auth / tokens (required: JWT_ACCESS_SECRET) ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# --- HTTP ---
# Comma-separated list of origins allowed to call the API from a browser.
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=https://your-frontend-domain.example.com
# Set true when running behind Dokploy's Traefik reverse proxy so client IPs are correct.
TRUST_PROXY=true
# Base URL of the frontend, used to build password-reset links.
APP_BASE_URL=https://your-frontend-domain.example.com
# The testing panel is disabled by default in production. Leave false.
ADMIN_PANEL_ENABLED=false

# --- Remote LLM cache service (client) ---
LLM_CACHE_URL=https://llm-cache.makonew.com
# Admin token for the cache service's /admin/api/* endpoints.
LLM_CACHE_ADMIN_TOKEN=replace-with-the-service-admin-token
LLM_CACHE_TIMEOUT_MS=120000

# --- Assistant (program matchmaking) ---
# REQUIRES a pgvector-enabled PostgreSQL (migration 0002 adds a vector column +
# HNSW index and creates the extension). Dokploy's stock managed PostgreSQL does
# NOT ship pgvector; use the repo's docker-compose.yml (pgvector/pgvector:pg17)
# or another pgvector-capable database. See DEPLOY.md section 13.
STORE_MODE=auto
# AI provider: auto | deterministic | http. `auto` uses the offline deterministic
# embeddings unless AI_API_KEY is set. AI_EMBEDDING_DIMENSIONS MUST stay 256 to
# match the programs.embedding vector(256) column.
AI_PROVIDER=auto
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=256
AI_TIMEOUT_MS=15000
ASSISTANT_SIMILARITY_THRESHOLD=0.35
ASSISTANT_CANDIDATE_LIMIT=20
ASSISTANT_MAX_RESULTS=5
ASSISTANT_PAGE_SIZE=3
ASSISTANT_MAX_PAGE_SIZE=20

# --- Startup behavior (read by docker-entrypoint.sh) ---
# Wait for the database to accept connections before starting.
WAIT_FOR_DB=true
# Apply pending Drizzle migrations on every start (idempotent).
RUN_MIGRATIONS=true
# Load demo content on start. WARNING: this resets content tables. Use true only
# on a fresh/staging environment, never on production with real content.
RUN_SEED=false
# Seed the example assistant programs on start. Idempotent: it does nothing if
# the programs table already has rows.
RUN_SEED_ASSISTANT=false
# Import the public ROPS Innovation Library catalogue (data/import) on start.
# Runs the DB import, then bridges the innovations into the assistant's
# programme index so the chatbot can recommend them. Idempotent; safe to enable.
RUN_SEED_INNOVATIONS=false
# Seconds to wait for the database before failing fast.
DB_WAIT_TIMEOUT=60
