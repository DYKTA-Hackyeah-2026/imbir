# Copy to .env and adjust. Used in production/compose deployment.
NODE_ENV=production
PORT=3000
API_PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://backend:change-me@db:5432/backend
DB_SSL=false
DB_POOL_MAX=10

# Auth / tokens — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# HTTP
CORS_ORIGINS=https://example.com
TRUST_PROXY=true
APP_BASE_URL=https://example.com
# Disable the /panel testing panel in production unless you really need it.
ADMIN_PANEL_ENABLED=false

# Remote LLM cache service (client; see API.md)
LLM_CACHE_URL=https://llm-cache.makonew.com
LLM_CACHE_ADMIN_TOKEN=replace-with-the-service-admin-token
LLM_CACHE_TIMEOUT_MS=120000

# Matchmaking storage: auto | postgres | memory
# auto prefers PostgreSQL and falls back to the in-memory demo catalogue.
STORE_MODE=postgres
# Directory of manual import JSON files (unset to disable).
MATCHMAKING_IMPORT_DIR=

# AI provider: auto | deterministic | http
# auto uses the offline deterministic provider unless AI_API_KEY is set.
AI_PROVIDER=auto
AI_BASE_URL=https://api.openai.com/v1
# Server-side only; never expose to the browser. Leave empty for offline mode.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=256
AI_TIMEOUT_MS=15000

# Assistant (program matchmaking + pgvector)
# Requires a pgvector-enabled database (the compose db uses pgvector/pgvector:pg17).
ASSISTANT_SIMILARITY_THRESHOLD=0.35
ASSISTANT_CANDIDATE_LIMIT=20
ASSISTANT_MAX_RESULTS=5
ASSISTANT_PAGE_SIZE=3
ASSISTANT_MAX_PAGE_SIZE=20

# Startup behavior (read by docker-entrypoint.sh at runtime)
WAIT_FOR_DB=true
RUN_MIGRATIONS=true
# WARNING: resets content tables. Use only on a fresh/staging environment.
RUN_SEED=false
# Seed the example assistant programs on start; idempotent (skips if programs exist).
RUN_SEED_ASSISTANT=false
DB_WAIT_TIMEOUT=60

# Postgres container (docker compose); also created by docker-compose.yml
POSTGRES_USER=backend
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=backend
POSTGRES_PORT=5432
