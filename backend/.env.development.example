# Copy to .env.development and adjust. Used by `docker compose -f docker-compose.dev.yml up`
# and by `npm run dev` locally (dotenv loads .env.development automatically when NODE_ENV=development).
NODE_ENV=development
PORT=4000
API_PORT_DEV=4000
LOG_LEVEL=debug

# PostgreSQL (from the host: localhost, from inside docker network: db)
DATABASE_URL=postgres://backend:backend@localhost:5432/backend
DB_SSL=false
DB_POOL_MAX=10

# Auth / tokens
JWT_ACCESS_SECRET=dev-secret-change-me-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=10

# HTTP
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
APP_BASE_URL=http://localhost:5173
ADMIN_PANEL_ENABLED=true

# Remote LLM cache service (client; see API.md)
LLM_CACHE_URL=https://llm-cache.makonew.com
# Admin token for the remote /admin/api/* endpoints. Ask the service owner.
LLM_CACHE_ADMIN_TOKEN=
LLM_CACHE_TIMEOUT_MS=120000

# Matchmaking storage: auto | postgres | memory
# auto prefers PostgreSQL and falls back to the in-memory demo catalogue.
STORE_MODE=auto
# Directory of manual import JSON files (unset to disable).
MATCHMAKING_IMPORT_DIR=

# AI provider: auto | deterministic | http
# auto uses the offline deterministic provider unless AI_API_KEY is set.
AI_PROVIDER=auto
AI_BASE_URL=https://api.openai.com/v1
# Server-side only; never expose to the browser. Leave empty for offline mode.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=256
AI_TIMEOUT_MS=15000

# Assistant (program matchmaking + pgvector)
ASSISTANT_SIMILARITY_THRESHOLD=0.35
ASSISTANT_CANDIDATE_LIMIT=20
ASSISTANT_PAGE_SIZE=3
ASSISTANT_MAX_PAGE_SIZE=20

# Postgres container (docker compose dev); also created by docker-compose.dev.yml
POSTGRES_USER=backend
POSTGRES_PASSWORD=backend
POSTGRES_DB=backend
POSTGRES_PORT=5432
