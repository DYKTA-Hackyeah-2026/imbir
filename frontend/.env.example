# Build-time (Vite). Leave empty to call the API through this server (nginx
# proxies /auth, /llm and /health). Set to an absolute URL only if the backend
# allows this origin via CORS.
VITE_API_URL=

# Runtime (container environment, consumed by nginx on startup).
# Origin that nginx proxies /auth, /llm and /health to.
BACKEND_URL=https://hackathon-backend.makonew.com

# Port nginx listens on inside the container.
NGINX_PORT=80
